--- /dev/null
+++ b/ros_ws/src/ur16e_mtc_gpio_stage/test/test_tcp_waypoints.cpp
@@ -0,0 +1,89 @@
+#include <gtest/gtest.h>
+#include "ur16e_mtc_gpio_stage/tcp_waypoints.hpp"
+#include <limits>
+#include "ur16e_mtc_gpio_stage/plan_gate.hpp"
+
+using ur16e_mtc_gpio_stage::validatedTcpWaypoints;
+namespace
+{
+geometry_msgs::msg::PoseArray request()
+{
+  geometry_msgs::msg::PoseArray value;
+  value.header.frame_id = "ur_base_link";
+  value.header.stamp.sec = 17; value.header.stamp.nanosec = 123;
+  value.poses.resize(2);
+  value.poses[0].position.x = 0.2;
+  value.poses[0].orientation.w = 1;
+  value.poses[1].position.y = -0.3;
+  value.poses[1].orientation.x = 0.5;
+  value.poses[1].orientation.w = 0.5;
+  return value;
+}
+TEST(TcpWaypoints, PreservesBothFullPosesOrderAndFrameWithoutOffsets)
+{
+  const auto input = request();
+  const auto output = validatedTcpWaypoints(input);
+  EXPECT_EQ(output.header, input.header);
+  ASSERT_EQ(output.poses.size(), 2u);
+  EXPECT_EQ(output.poses[0].position, input.poses[0].position);
+  EXPECT_EQ(output.poses[1].position, input.poses[1].position);
+  EXPECT_DOUBLE_EQ(output.poses[0].orientation.w, 1.0);
+  EXPECT_NEAR(output.poses[1].orientation.x, std::sqrt(0.5), 1e-14);
+  EXPECT_NEAR(output.poses[1].orientation.w, std::sqrt(0.5), 1e-14);
+}
+TEST(TcpWaypoints, RejectsWrongFrameAndEveryWrongPoseCount)
+{
+  auto input = request(); input.header.frame_id = "world";
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+  for (const std::size_t count : {0u, 1u, 3u})
+  {
+    input = request(); input.poses.resize(count);
+    EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+  }
+}
+TEST(TcpWaypoints, RejectsInvalidSecondGoalBeforeAnyTaskIsBuilt)
+{
+  auto input = request(); input.poses[1].position.z = std::numeric_limits<double>::quiet_NaN();
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+  input = request(); input.poses[1].orientation.w = std::numeric_limits<double>::infinity();
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+  input = request(); input.poses[1].orientation.x = input.poses[1].orientation.w = 0;
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+}
+TEST(TcpWaypoints, QuaternionSignAndScaleKeepPhysicalOrientation)
+{
+  auto input = request(); input.poses[0].orientation.w = -5;
+  EXPECT_DOUBLE_EQ(validatedTcpWaypoints(input).poses[0].orientation.w, -1);
+  input.poses[0].orientation.w = std::numeric_limits<double>::max();
+  EXPECT_DOUBLE_EQ(validatedTcpWaypoints(input).poses[0].orientation.w, 1);
+}
+TEST(TcpWaypoints, RequestTokenMustBeNonzeroAndHasStableStringRepresentation)
+{
+  auto input = request();
+  EXPECT_EQ(ur16e_mtc_gpio_stage::tcpRequestId(input.header.stamp), "17:123");
+  input.header.stamp.sec = 0; input.header.stamp.nanosec = 0;
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+  input.header.stamp.nanosec = 1000000000u;
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+  input.header.stamp.sec = -1; input.header.stamp.nanosec = 0;
+  EXPECT_THROW(validatedTcpWaypoints(input), std::invalid_argument);
+}
+TEST(TcpWaypoints, WrongIdAndLegacyExecuteCannotConsumeTcpPlan)
+{
+  using Mode = ur16e_mtc_gpio_stage::PlannedTaskMode;
+  using ur16e_mtc_gpio_stage::matchesExecutionRequest;
+  ur16e_mtc_gpio_stage::PlanGate gate;
+  ASSERT_TRUE(gate.beginPlanning()); gate.finishPlanning(true);
+  EXPECT_FALSE(matchesExecutionRequest(Mode::TcpWaypoints, "17:123", Mode::TcpWaypoints, "old:1"));
+  EXPECT_FALSE(matchesExecutionRequest(Mode::TcpWaypoints, "17:123", Mode::TcpWaypoints, ""));
+  EXPECT_FALSE(matchesExecutionRequest(Mode::TcpWaypoints, "17:123", Mode::VacuumPickPlace, ""));
+  EXPECT_FALSE(matchesExecutionRequest(Mode::VacuumPickPlace, "", Mode::TcpWaypoints, "17:123"));
+  EXPECT_EQ(gate.state(), ur16e_mtc_gpio_stage::PlanGate::State::Planned);
+  ASSERT_TRUE(matchesExecutionRequest(Mode::TcpWaypoints, "17:123", Mode::TcpWaypoints, "17:123"));
+  ASSERT_TRUE(gate.beginExecution(true));
+  EXPECT_FALSE(gate.beginExecution(true)); // eligibility consumed atomically
+  gate.finishExecution(true);
+  EXPECT_FALSE(gate.beginExecution(true));
+  EXPECT_TRUE(matchesExecutionRequest(Mode::VacuumPickPlace, "", Mode::VacuumPickPlace, ""));
+}
+} // namespace
