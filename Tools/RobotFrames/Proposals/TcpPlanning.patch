 }
+// Boolean capabilities follow the same immutable startup contract as strings.
+inline bool readOnlyStartupBool(const rclcpp::Node::SharedPtr &node,
+                                const std::string &name, bool default_value)
+{
+  if (!node)
+    throw std::invalid_argument("A node is required for startup parameters");
+  rcl_interfaces::msg::ParameterDescriptor descriptor;
+  descriptor.read_only = true;
+  descriptor.description = "Selected at startup; restart the node to change it";
+  if (!node->has_parameter(name))
+    return node->declare_parameter<bool>(name, default_value, descriptor);
+  const auto parameter = node->get_parameter(name);
+  if (parameter.get_type() != rclcpp::ParameterType::PARAMETER_BOOL)
+    throw std::invalid_argument("Startup parameter '" + name + "' must be a bool");
+  const bool value = parameter.as_bool();
+  const auto existing = node->describe_parameter(name);
+  if (existing.read_only)
+    return value;
+  if (!existing.dynamic_typing)
+    throw std::invalid_argument("Startup parameter '" + name + "' was already declared mutable and statically typed");
+  node->undeclare_parameter(name);
+  return node->declare_parameter<bool>(name, value, descriptor, true);
+}
 } // namespace ur16e_mtc_gpio_stage
diff --git a/ros_ws/src/ur16e_mtc_gpio_stage/include/ur16e_mtc_gpio_stage/tcp_waypoints.hpp b/ros_ws/src/ur16e_mtc_gpio_stage/include/ur16e_mtc_gpio_stage/tcp_waypoints.hpp
new file mode 100644
--- /dev/null
+++ b/ros_ws/src/ur16e_mtc_gpio_stage/include/ur16e_mtc_gpio_stage/tcp_waypoints.hpp
@@ -0,0 +1,51 @@
+#pragma once
+
+#include <geometry_msgs/msg/pose_array.hpp>
+#include <cmath>
+#include <stdexcept>
+#include <string>
+
+namespace ur16e_mtc_gpio_stage
+{
+enum class PlannedTaskMode { VacuumPickPlace, TcpWaypoints };
+
+// Check before consuming readiness, while the caller holds its plan mutex.
+inline bool matchesExecutionRequest(PlannedTaskMode prepared_mode, const std::string &prepared_id,
+                                    PlannedTaskMode requested_mode, const std::string &requested_id)
+{
+  return prepared_mode == requested_mode &&
+      (requested_mode == PlannedTaskMode::VacuumPickPlace ||
+       (!requested_id.empty() && requested_id == prepared_id));
+}
+
+// Exact TCP goals have a separate contract from tile top-surface poses. Validate
+// the complete request before building stages, and normalize without changing
+// physical orientation. No flange offset, yaw sampling or object pose is applied.
+inline geometry_msgs::msg::PoseArray validatedTcpWaypoints(geometry_msgs::msg::PoseArray request)
+{
+  if (request.header.frame_id != "ur_base_link")
+    throw std::invalid_argument("TCP A/B goals must be expressed in ur_base_link");
+  if ((request.header.stamp.sec == 0 && request.header.stamp.nanosec == 0) ||
+      request.header.stamp.sec < 0 || request.header.stamp.nanosec >= 1000000000u)
+    throw std::invalid_argument("TCP planning requires a nonzero valid request stamp");
+  if (request.poses.size() != 2)
+    throw std::invalid_argument("TCP planning requires exactly two poses: A then B");
+  for (auto &pose : request.poses)
+  {
+    const auto &p = pose.position;
+    auto &q = pose.orientation;
+    if (!std::isfinite(p.x) || !std::isfinite(p.y) || !std::isfinite(p.z) ||
+        !std::isfinite(q.x) || !std::isfinite(q.y) || !std::isfinite(q.z) || !std::isfinite(q.w))
+      throw std::invalid_argument("TCP goals require finite positions and quaternions");
+    const double norm = std::hypot(std::hypot(q.x, q.y), std::hypot(q.z, q.w));
+    if (!std::isfinite(norm) || norm < 1e-12)
+      throw std::invalid_argument("TCP goals require nonzero finite quaternions");
+    q.x /= norm; q.y /= norm; q.z /= norm; q.w /= norm;
+  }
+  return request;
+}
+inline std::string tcpRequestId(const builtin_interfaces::msg::Time &stamp)
+{
+  return std::to_string(stamp.sec) + ":" + std::to_string(stamp.nanosec);
+}
+} // namespace ur16e_mtc_gpio_stage
