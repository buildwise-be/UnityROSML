    <plugin>ur_robot_driver/URPositionHardwareInterface</plugin>\r\n    <param name=\"robot_ip\">0.0.0.0</param>\r\n   
    <param name=\"script_filename\"></param>\r\n    <param name=\"output_recipe_filename\"></param>\r\n   
